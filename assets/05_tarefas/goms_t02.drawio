        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;Operators M2&lt;/b&gt;&lt;br&gt;Perceber relato semelhante &amp;gt; abrir &amp;gt; comparar &amp;gt; decidir &amp;gt; indicar possível correspondência &amp;gt; fornecer detalhe adicional &amp;gt; ler orientação &amp;gt; encaminhar o objeto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="880" y="390" width="600" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="selection" value="&lt;b&gt;Selection Rule SR1&lt;/b&gt;&lt;br&gt;Usar M1 quando não houver relato compatível ou a busca for inconclusiva. Usar M2 quando existir relato semelhante, sem assumir que a propriedade foi comprovada." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="625" width="960" height="95" as="geometry"/>
