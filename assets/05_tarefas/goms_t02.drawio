        <mxCell id="legend" value="&lt;b&gt;Operadores adotados:&lt;/b&gt; P — perceber; D — decidir; A — apontar ou selecionar; K — digitar ou confirmar; F — fotografar; E — entregar fisicamente." style="text;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
