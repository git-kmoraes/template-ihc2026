          <mxGeometry x="980" y="255" width="400" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;Operators M1&lt;/b&gt;&lt;br&gt;Perceber que não existe relato compatível &amp;gt; selecionar categoria, local e período &amp;gt; digitar descrição &amp;gt; fotografar quando seguro &amp;gt; reservar característica de confirmação &amp;gt; enviar &amp;gt; ler orientação &amp;gt; encaminhar o objeto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
