        <mxCell id="goal" value="&lt;b&gt;Goal G0&lt;/b&gt;&lt;br&gt;Registrar o item encontrado e transferir sua responsabilidade de forma compreensível" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
